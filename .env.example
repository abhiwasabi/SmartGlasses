# Server only. Never prefix these with VITE_. Copy this file to .env.local.
GEMINI_API_KEY=
# Use a Live model available to your Gemini project.
GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional ElevenLabs reply voice. Configure both to enable; leave both empty for Gemini voice.
# Keep the API key server-only. Obtain the voice ID from your ElevenLabs account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# The public Supabase URL and publishable key are shared in the tracked .env file.
