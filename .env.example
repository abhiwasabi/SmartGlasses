# Server only. Never prefix these with VITE_. Keep real values private.
# Copy to .env.local for private Python and local Vite settings.
GEMINI_API_KEY=
# Optional for the Python goal-based assistant:
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=true
# Use a Live model available to your Gemini project.
GEMINI_LIVE_MODEL=gemini-3.8-live

# ElevenLabs is optional for Live replies; configure both for its voice.
# The Python assistant uses the key for alerts and can fall back to Windows speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# The public Supabase URL and publishable key are shared in the tracked .env file.
